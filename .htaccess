ErrorDocument 403 /404.html
ErrorDocument 404 /404.html

DirectoryIndex index.html

RewriteEngine On

RewriteRule ^help/integration/iiko-self/?$ /help/integration/syrve-self [R=301,L]
RewriteRule ^help/integration/iiko/?$ /help/integration/syrve [R=301,L]
RewriteRule ^help/settings/certificate-ooo/?$ /help/settings/certificate-company [R=301,L]
RewriteRule ^extra/?$ / [R=301,L]
RewriteRule ^materials/?$ / [R=301,L]
RewriteRule ^help/api/?$ /api [R=301,L]
RewriteRule ^integrations/api/?$ /api [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$
RewriteCond %{HTTP_HOST} !^\[::1\](:[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.passquare\.com$ [NC]
RewriteRule ^ https://passquare.com%{REQUEST_URI} [R=301,L]
